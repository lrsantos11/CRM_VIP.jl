end

"""
    generate_all_tables()

Generate LaTeX tables for all three examples (5.1, 5.2, 5.3).
"""
function generate_all_tables()
    println("\n" * "="^70)
    println("GENERATING ALL LATEX TABLES")
    println("="^70)

    generate_tables_5_1()
    println("\n")
    generate_tables_5_2()
    println("\n")
    generate_tables_5_3()

    println("\n" * "="^70)
    println("All tables generated successfully!")
    println("\nOutput files created:")
    println("  - tables_5_1A.tex, tables_5_1BC.tex")
    println("  - tables_5_2A.tex, tables_5_2BC.tex")
    println("  - tables_5_3A.tex, tables_5_3BC.tex")
    println("="^70)
end

#=============================================================================
    MAIN EXECUTION
=============================================================================#

# Uncomment to run:
# generate_tables_5_1()
# generate_tables_5_2()
# generate_tables_5_3()
generate_all_tables()