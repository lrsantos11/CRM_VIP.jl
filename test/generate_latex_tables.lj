            write(io, "\n\n\n")
            write(io, generate_speedup_table(agg_BC, "Example_2", "B \\& C", METHOD_ORDER_APPROX))
        end
        println("  ✓ Saved to $output_BC")
    end

    println("\n" * "="^70)
    println("Example 5.2 tables generated successfully!")
    println("="^70)
end

"""
